# Copia este archivo como ".env" para desarrollo local,
# y carga estas mismas variables en Netlify (Site settings > Environment variables).
# Los valores salen de tu proyecto de Firebase: Configuración del proyecto > Tus apps > SDK config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
